[Unit]
# THE CORPUS'S SECOND DEFENCE -- #1795, split from #43. See `a11y-corpus-snapshot.timer` for the shared
# reasoning; this one fires the copy off the box.
Description=a11y: fire the corpus backup job daily, after the snapshot

[Timer]
# TWO HOURS AFTER THE SNAPSHOT'S OWN 03:00 START, which is a full hour past its `RuntimeMaxSec=3600`
# ceiling -- so an honest snapshot has always finished by the time this fires, even on its slowest allowed
# run. Not chained off the snapshot's own completion (`OnSuccess=`), because #1795's acceptance needs BOTH
# to show a NEXT time in `systemctl list-timers`, which only an independently scheduled timer does; a
# success-chained unit has no schedule of its own until the thing ahead of it runs.
OnCalendar=*-*-* 05:00:00 UTC
Persistent=true
AccuracySec=1min
Unit=a11y-corpus-backup.service

[Install]
WantedBy=timers.target
