[Unit]
# THE IDLE-OFF POLL -- #2656. Fires `npm run fleet:auto-off`'s own script directly: unlike
# `a11y-corpus-snapshot.service`, there is no separately-named transient unit to avoid colliding with,
# because nothing dispatches this job by hand through `systemd-run` -- a manual run is a plain foreground
# `node fleet-auto-off.mjs`, so this unit and a manual run share no unit name to collide over.
Description=a11y: poll the fleet for idle workers and power them off

[Service]
Type=oneshot
# WITHOUT THIS, `ansible-playbook` IS UNREACHABLE -- systemd's default PATH
# (/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin) does not include
# `/root/.local/bin`, where `ansible-playbook` actually lives on `a11y-control` today. Confirmed live
# on #2725: with this line absent, `dispatchShutdown`'s `spawnSync("ansible-playbook", ...)` failed
# with ENOENT on every tick, silently, and `tick()`'s caller dropped the failure on the floor -- the
# fleet read every idle worker as dispatched, forever, and nothing ever actually shut down.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/root/.local/bin
# `--apply` IS HERE (#2784), OR THE TIMER IS A REPORT ON A CLOCK. `fleet-auto-off.mjs` defaults to report-only
# on purpose -- a stray manual `npm run fleet:auto-off` on the wrong box must not power anything off -- so the
# unit has to carry the flag, and a unit without it is installed, enabled, active, exits 0, prints 15
# `keep`/`off` lines every 10 s and shuts nothing down. #2656 shipped this unit without it, "the THIRD row's
# step"; #2734 was that third row, flipped the timer live, and left this line out -- so a fleet sat powered at
# 0 captures for 25h+ with both rows closed. `fleet-auto-off.test.ts` now pins the flag. The never-mid-capture
# guarantee does not depend on it: the `busy`/`no-answer` branches of `autoOffDecision` and `sleep.yml`'s own
# re-check immediately before the shutdown are what refuse a capturing worker.
#
# THE LITERAL PATH IS THE ONLY WAY A STATIC UNIT FILE CAN SAY THIS AT ALL -- it cannot import
# `control-plane-checkout.mjs`'s export the way a `.mjs` consumer does, the same reason
# `a11y-corpus-snapshot.service` names `/opt/a11y` literally for the lab's own checkout
# (`control-plane-checkout-is-one-fact.test.ts`). `a11y-witness` here is that same guard's own
# `CHECKOUT_NAME`, read out of `control-plane-checkout.mjs`, not a second literal invented for this file.
# `WorkingDirectory` IS HERE BECAUSE THE STATE PATH IS RELATIVE (#2784). `fleet-auto-off.mjs` keeps its idle
# clock at `runs/fleet-auto-off-state.json`, resolved against the process's cwd, and a systemd service starts
# in `/`: read live 2026-09-30 09:40Z, the first tick of the freshly installed timer died with
# `ENOENT: open 'runs/fleet-auto-off-state.json'` and so did every one after it, every ten seconds. The
# by-hand run that proved the shutdown had set `-p WorkingDirectory=/root/a11y-witness`, which is why the
# report looked fine. The failure is in the SAFE direction (nothing is powered off), which is also why a
# green unit suite could not see it. Same literal checkout as ExecStart, for the same reason.
WorkingDirectory=/root/a11y-witness
ExecStart=/usr/bin/node /root/a11y-witness/packages/control/src/fleet-auto-off.mjs --apply
