[Unit]
# See `a11y-corpus-snapshot.service` for why this trigger's name is deliberately not `a11y-job-corpus-backup`
# and what that name collision would break.
#
# EXPECTED TO FAIL until #1042's destination decision lands: `corpus-backup.mjs` reads `A11Y_CORPUS_REMOTE`
# and exits non-zero rather than reporting success with the corpus still on one disk. #1795's own acceptance
# says so explicitly -- that exit is the correct, documented behaviour and not a reason to hold this unit
# back from being scheduled.
Description=a11y: dispatch corpus-backup as a11y-job-corpus-backup

[Service]
Type=oneshot
WorkingDirectory=/opt/a11y

ExecStartPre=-/usr/bin/systemctl reset-failed a11y-job-corpus-backup
ExecStartPre=-/usr/bin/systemctl stop a11y-job-corpus-backup

# Same argv and timeout as `lab-job.yml`'s `corpus-backup` catalogue entry. NO `--wait` -- see
# `a11y-corpus-snapshot.service` for why: combined with `--remain-after-exit` it hangs this trigger
# forever, measured firing the snapshot half of this pair by hand on the lab.
ExecStart=/usr/bin/systemd-run --unit=a11y-job-corpus-backup --remain-after-exit \
  --description="corpus-backup (scheduled)" \
  --working-directory=/opt/a11y \
  --property=RuntimeMaxSec=7200 \
  --property=ReadWritePaths=/srv/a11y-runs \
  --setenv=PYTHONUNBUFFERED=1 \
  --setenv=PYTHONDONTWRITEBYTECODE=1 \
  -- /usr/bin/npm run corpus:backup
