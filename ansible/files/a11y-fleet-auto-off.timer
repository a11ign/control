[Unit]
# #2656: A WORKER IDLE FIVE MINUTES POWERS ITSELF OFF. Installed by `auto-off-schedule.yml`, which
# explicitly ensures this timer is `state: started, enabled: true` every time it runs. #2656 shipped it
# disabled, reserving enabling it for the THIRD row, after wake-on-demand was read live on the real fleet
# (#2655/#2657) and the `Fleet-hold-until:` read was removed as protecting nothing (#2737). This is that
# third row (#2734): the timer is live.
Description=a11y: poll the fleet for idle workers every 10s

[Timer]
# 10 s, strictly under the shortest measured capture (12 s, `sleep.yml`'s own header) -- `POLL_INTERVAL_MS`
# in `fleet-auto-off.mjs`, pinned by its own test. A gap at or above 12 s could let a whole capture start
# and finish between two polls and never be sampled `busy` at all; this cadence guarantees at least one
# poll lands inside any real capture.
OnBootSec=10s
OnUnitActiveSec=10s
AccuracySec=1s
Unit=a11y-fleet-auto-off.service

[Install]
WantedBy=timers.target
