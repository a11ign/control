{
  "name": "@a11ign/control",
  "version": "0.13.19",
  "private": true,
  "description": "The control plane: the machine that holds the fleet SSH key and dispatches work to it and to the lab. Deliberately dependency-free -- see ADR 0012.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./fleet-playbook": "./src/fleet-playbook.ts",
    "./lab-pipeline": "./src/lab-pipeline.ts",
    "./fleet-wake": "./src/fleet-wake.ts",
    "./layer-checkouts": "./src/layer-checkouts.ts",
    "./lab-carried": "./src/lab-carried.ts"
  },
  "scripts": {
    "doctor": "node src/with-control-plane-fleet.ts doctor",
    "worker:code": "node src/with-control-plane-fleet.ts worker-code",
    "fleet:status": "node src/fleet-status.ts",
    "fleet:link-view": "ANSIBLE_CONFIG=ansible/ansible.cfg ansible-playbook ansible/fleet-link-view.yml",
    "fleet:discover": "node src/fleet-discover.ts",
    "fleet:wake": "node src/fleet-wake.ts",
    "fleet:auto-off": "node src/fleet-auto-off.ts",
    "fleet:auto-off-schedule": "ANSIBLE_CONFIG=ansible/ansible.cfg ansible-playbook ansible/auto-off-schedule.yml",
    "fleet:patch-schedule": "ANSIBLE_CONFIG=ansible/ansible.cfg ansible-playbook ansible/patch-schedule.yml",
    "lab:job": "node src/lab-job.ts",
    "lab:pipeline": "node src/lab-pipeline.ts",
    "lab:failed-units": "node src/lab-failed-units.ts",
    "lab:watch": "node src/lab-watch.ts",
    "fleet:watch": "node src/fleet-watch.ts",
    "lab:status": "ANSIBLE_CONFIG=ansible/ansible.cfg ansible-playbook ansible/lab-status.yml",
    "lab:log": "ANSIBLE_CONFIG=ansible/ansible.cfg ansible-playbook ansible/lab-log.yml",
    "fleet:tailscale": "ANSIBLE_CONFIG=ansible/ansible.cfg ansible-playbook ansible/tailscale.yml",
    "fleet:deploy": "node src/fleet-playbook.ts --playbook=deploy.yml",
    "fleet:sleep": "node src/fleet-playbook.ts --playbook=sleep.yml",
    "fleet:provision": "node src/fleet-playbook.ts --playbook=provision-role.yml",
    "fleet:patch": "node src/fleet-playbook.ts --playbook=patch.yml",
    "lab:fetch": "ANSIBLE_CONFIG=ansible/ansible.cfg ansible-playbook ansible/lab-fetch.yml",
    "lab:stop": "ANSIBLE_CONFIG=ansible/ansible.cfg ansible-playbook ansible/lab-stop.yml",
    "lab:clear-failed": "ANSIBLE_CONFIG=ansible/ansible.cfg ansible-playbook ansible/lab-clear-failed.yml",
    "lab:reset": "ANSIBLE_CONFIG=ansible/ansible.cfg ansible-playbook ansible/lab-reset.yml",
    "lab:corpus-schedule": "ANSIBLE_CONFIG=ansible/ansible.cfg ansible-playbook ansible/corpus-schedule.yml",
    "fleet:recover": "node src/fleet-playbook.ts --playbook=recover.yml",
    "fleet:logs": "node src/fleet-playbook.ts --playbook=collect-logs.yml",
    "fleet:os-rollback": "node src/fleet-playbook.ts --playbook=os-rollback.yml",
    "fleet:inventory-install": "node src/fleet-playbook.ts --playbook=inventory-install.yml",
    "fleet:control-host-install": "node src/fleet-playbook.ts --playbook=control-host-install.yml",
    "typecheck": "tsc --noEmit",
    "test": "rstest run --config scripts/rstest/rstest.config.ts",
    "layout-check": "layout-check",
    "changeset": "changeset"
  },
  "//": "THE DEPENDENCIES ARE EXACTLY THE TWO PUBLISHED LAYERS, each at the version deploy-pins.json names (ADR 0045 cut 9, ceo ruling on a11ign#5312). ADR 0012 kept this package to a raw checkout with no node_modules, because the credential that reconfigures the fleet sat beside the largest supply-chain surface; ADR 0045 item 5 removed that and named the mechanism as this row. control-has-no-dependencies.test.ts is the guarantee: no other declared dependency, and no package-name import outside these two. The plane installs with `pnpm install --frozen-lockfile --ignore-scripts` and nothing else, so the third-party closure beside the key is what the lockfile pins. tsx is a devDependency: the test child runs TypeScript and the plane installs production dependencies only. The `devDependencies` are the repository's own tooling, and a new one is a reviewed change.",
  "dependencies": {
    "@a11ign/screenreader-fleet": "0.10.2",
    "@a11ign/screenreader-worker": "0.13.0"
  },
  "devDependencies": {
    "@a11ign/toolchain": "^0.1.7",
    "@changesets/cli": "3.0.3",
    "@rstest/core": "^0.12.3",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
